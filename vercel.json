{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "_site",
  "functions": {
    "api/game-scam-guard.js": {
      "maxDuration": 180,
      "includeFiles": "services/game-scam-guard/server/{preview-worker.mjs,preview-renderer.mjs,artifact-worker.mjs,artifact-engine.js,cloud-execution-worker.py,vendor/**}"
    },
    "api/malguard-ai.js": {
      "maxDuration": 120,
      "includeFiles": "services/game-scam-guard/server/{preview-worker.mjs,preview-renderer.mjs,artifact-worker.mjs,artifact-engine.js,cloud-execution-worker.py,vendor/**}"
    },
    "api/preview-backend.js": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/ai-product",
      "destination": "/ai-product.html"
    },
    {
      "source": "/api/game-scam-guard/auth/status",
      "destination": "/api/preview-backend?path=auth-status"
    },
    {
      "source": "/api/game-scam-guard/auth/start",
      "destination": "/api/preview-backend?path=auth-start"
    },
    {
      "source": "/api/game-scam-guard/auth/verify",
      "destination": "/api/preview-backend?path=auth-verify"
    },
    {
      "source": "/api/game-scam-guard/auth/password",
      "destination": "/api/preview-backend?path=auth-password"
    },
    {
      "source": "/api/game-scam-guard/auth/session",
      "destination": "/api/preview-backend?path=auth-session"
    },
    {
      "source": "/api/game-scam-guard/auth/availability",
      "destination": "/api/preview-backend?path=auth-availability"
    },
    {
      "source": "/api/game-scam-guard/:endpoint*",
      "destination": "/api/game-scam-guard?endpoint=:endpoint*"
    },
    {
      "source": "/api/malguard-ai/:endpoint",
      "destination": "/api/malguard-ai?endpoint=:endpoint"
    },
    {
      "source": "/api/public-models",
      "destination": "/api/preview-backend?path=public-models"
    },
    {
      "source": "/api/public-model-chat",
      "destination": "/api/preview-backend?path=public-model-chat"
    },
    {
      "source": "/api/account-usage",
      "destination": "/api/preview-backend?path=account-usage"
    },
    {
      "source": "/api/public-media",
      "destination": "/api/preview-backend?path=public-media"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-EJyEwh1wvlhuP5s3QEN54E1xS17DshAOEAjhJQxDumM=' 'sha256-hP3EVA1zinexU3pVtp7TLu2NkQR4bLZjkmDxB35RMr8=' 'sha256-PM4tiPian8VJhIKFAWn+kuyklPIxGLOUcd9xI6NJAKo=' 'sha256-nPis3DGNgw9p0DhW0v3s2BYPwpO78kDuZs2NzPFbm4I='; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://www.bestpractices.dev; media-src 'self' blob:; font-src 'self' data:; connect-src 'self' https://malware-ai-gray.vercel.app; worker-src 'self' blob:; frame-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=(), payment=(), usb=()"
        }
      ]
    },
    {
      "source": "/game-scam-guard/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/game-scam-guard/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/ai/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; frame-src 'self'; style-src 'self'; connect-src 'self' http://127.0.0.1:11434 https://game-scam-guard-connected.vercel.app https://models.malguard.site https://malware-ai-git-web-pro-p0-mcazarderakhsh-4187.vercel.app https://huggingface.co https://*.hf.co https://raw.githubusercontent.com; img-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        },
        {
          "key": "Access-Control-Allow-Origin",
          "value": ""
        }
      ]
    },
    {
      "source": "/code-preview/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'none'; script-src 'self' 'unsafe-inline'; style-src 'unsafe-inline'; frame-src 'none'; img-src data:; connect-src 'none'; worker-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": {
      "feature/malguard-ai-evidence-first": false
    }
  }
}
