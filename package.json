{
  "name": "malguard-public-site",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "start:ai": "node services/malguard-ai/server/index.js",
    "test:ai": "node --test services/malguard-ai/test/*.test.js",
    "test:ai:browser": "node tests/malguard-ai-browser.mjs",
    "test:ai:local": "node tests/malguard-ai-local-onboarding.mjs",
    "check:ai": "node tools/check-malguard-ai.mjs",
    "build:opening": "node tools/build-home-opening.mjs",
    "build:forms": "node tools/build-secure-forms.mjs",
    "test:static": "python3 tests/validate-site.py",
    "test:experience": "node tests/experience.mjs",
    "test:motion": "node tests/motion-smoke.mjs",
    "build": "npm run build:ai && npm run build:game-scam-guard && python3 tools/build-public-site.py",
    "build:game-scam-guard": "node tools/build-gamescam-guide.mjs && vite build --config services/game-scam-guard/vite.config.js",
    "test:game-scam-guard": "node tests/game-scam-integration.test.mjs && npm --prefix services/game-scam-guard test",
    "build:ai": "node tools/build-ai-local.mjs",
    "test:ai:builder": "node tests/malguard-ai-builder.mjs"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "@vitejs/plugin-react": "^4.4.0",
    "country-flag-icons": "1.6.20",
    "earcut": "3.0.2",
    "esbuild": "0.25.10",
    "libphonenumber-js": "1.13.15",
    "playwright": "1.62.1",
    "three": "0.180.0",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "@babel/parser": "7.29.9",
    "@clerk/clerk-js": "6.39.0",
    "@mlc-ai/web-llm": "0.2.86",
    "@vercel/sandbox": "3.6.1",
    "@zip.js/zip.js": "2.23.0",
    "busboy": "1.6.0",
    "cheerio": "^1.0.0",
    "express": "^5.1.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
