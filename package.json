{
  "name": "malguard-public-site",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build:opening": "node tools/build-home-opening.mjs",
    "build:forms": "node tools/build-secure-forms.mjs",
    "test:static": "python3 tests/validate-site.py",
    "test:experience": "node tests/experience.mjs",
    "test:motion": "node tests/motion-smoke.mjs",
    "build": "npm run build:game-scam-guard && python3 tools/build-public-site.py",
    "build:game-scam-guard": "node tools/build-gamescam-guide.mjs && vite build --config services/game-scam-guard/vite.config.js",
    "test:game-scam-guard": "node tests/game-scam-integration.test.mjs && npm --prefix services/game-scam-guard test"
  },
  "devDependencies": {
    "@noble/hashes": "1.8.0",
    "@vitejs/plugin-react": "^4.4.0",
    "country-flag-icons": "1.6.20",
    "earcut": "3.0.2",
    "esbuild": "0.25.10",
    "libphonenumber-js": "1.13.15",
    "playwright": "1.62.1",
    "three": "0.180.0",
    "vite": "^6.3.0"
  },
  "dependencies": {
    "@clerk/clerk-js": "6.39.0",
    "@vercel/sandbox": "3.6.1",
    "@zip.js/zip.js": "2.23.0",
    "busboy": "1.6.0",
    "cheerio": "^1.0.0",
    "express": "^5.1.0",
    "http-proxy-agent": "^7.0.2",
    "https-proxy-agent": "^7.0.6",
    "ipaddr.js": "^2.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@babel/parser": "7.29.9"
  }
}
